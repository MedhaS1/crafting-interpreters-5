  {
    var d = "inner";
    print a + " " + b + " " + d + " " + global;
    a = "changed";
  }
  print a;
}

fun fib(n) {
  if (n < 2) return n;
  return fib(n - 1) + fib(n - 2);
}
print fib(20);
